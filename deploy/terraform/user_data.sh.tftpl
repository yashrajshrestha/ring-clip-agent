#!/bin/bash
# First-boot setup for the Ring Clip Agent demo (Ubuntu 24.04, arm64 / Graviton).
# Rendered by Terraform; progress goes to /var/log/ringclip/bootstrap.log and CloudWatch.
set -euxo pipefail
mkdir -p /var/log/ringclip
exec > >(tee -a /var/log/ringclip/bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y python3-venv python3-pip git nginx ffmpeg unzip curl

# AWS CLI v2 (arm64) for the S3 sync
curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscli.zip
unzip -q /tmp/awscli.zip -d /tmp && /tmp/aws/install --update

# CloudWatch agent: ship the app logs and memory/CPU metrics
curl -sSL "https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/arm64/latest/amazon-cloudwatch-agent.deb" -o /tmp/cwagent.deb
dpkg -i /tmp/cwagent.deb
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'JSON'
{
  "agent": {"metrics_collection_interval": 60},
  "logs": {"logs_collected": {"files": {"collect_list": [
    {"file_path": "/var/log/ringclip/bootstrap.log",  "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/bootstrap"},
    {"file_path": "/var/log/ringclip/decider.log",    "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/decider"},
    {"file_path": "/var/log/ringclip/playground.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/playground"},
    {"file_path": "/var/log/nginx/access.log",        "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/nginx-access"},
    {"file_path": "/var/log/ringclip/coolbench.log",  "log_group_name": "${log_group}", "log_stream_name": "{instance_id}/coolbench"}
  ]}}},
  "metrics": {"namespace": "RingClipAgent", "metrics_collected": {
    "mem": {"measurement": ["mem_used_percent"]},
    "cpu": {"measurement": ["cpu_usage_active"], "totalcpu": true}
  }}
}
JSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s

# App user, code and Python environment
id ringclip >/dev/null 2>&1 || useradd --system --create-home --home-dir /opt/ringclip --shell /usr/sbin/nologin ringclip
cd /opt/ringclip
rm -rf app && git clone --depth 1 --branch "${repo_ref}" "${repo_url}" app
python3 -m venv venv
venv/bin/pip install --upgrade pip
venv/bin/pip install torch --index-url https://download.pytorch.org/whl/cpu
venv/bin/pip install -r app/requirements.txt -r app/requirements-decider.txt

# OpenCV Model Zoo YOLOX-S detector for live Re-run / Look harder, checked by hash
cd /opt/ringclip/app && /opt/ringclip/venv/bin/python - <<'PY'
import hashlib, os, urllib.request
from vision import detector as m
dst = os.path.join("models", m.MODEL_FILE)
os.makedirs("models", exist_ok=True)
urllib.request.urlretrieve(m.MODEL_URL, dst)
digest = hashlib.sha256(open(dst, "rb").read()).hexdigest()
assert digest == m.MODEL_SHA256, f"model hash mismatch: {digest}"
print("detector ok", os.path.getsize(dst))
PY
cd /opt/ringclip

# The analysed clips (OpenCV timelines + videos) from the private bucket
mkdir -p app/web/public/samples
aws s3 sync "s3://${bucket}/samples/" app/web/public/samples/ --region "${region}" --only-show-errors
chown -R ringclip:ringclip /opt/ringclip /var/log/ringclip

# Decider weights (adapter + base model), fetched once before the service starts
sudo -u ringclip HF_HOME=/opt/ringclip/hf /opt/ringclip/venv/bin/python - <<'PY'
from huggingface_hub import snapshot_download
snapshot_download("${decider_checkpoint}")
snapshot_download("Qwen/Qwen3.5-2B-Base")
PY

# Which OpenCV build the pipeline uses: COOL's (/opt/cool) when the image has it and it imports, else the pip wheel
mkdir -p /etc/ringclip
: > /etc/ringclip/opencv.env
COOL_ENV="PYTHONPATH=/opt/cool/python_3.12/site-packages LD_LIBRARY_PATH=/opt/cool/cpp_sdk/lib"
%{ if use_cool ~}
SAMPLE=$(ls /opt/ringclip/app/web/public/samples/*.mp4 | head -1)
if sudo -u ringclip env $COOL_ENV /opt/ringclip/venv/bin/python -c "import cv2, sys; ok = cv2.VideoCapture(sys.argv[1]).read()[0]; print('COOL OpenCV', cv2.__version__, cv2.__file__, 'reads mp4:', ok); sys.exit(0 if ok else 1)" "$SAMPLE"; then
  printf 'PYTHONPATH=/opt/cool/python_3.12/site-packages\nLD_LIBRARY_PATH=/opt/cool/cpp_sdk/lib\n' > /etc/ringclip/opencv.env
  # Measure both builds on the published clips before anything else competes for the CPU
  cd /opt/ringclip/app
  CLIPS=$(ls web/public/samples/*.mp4)
  {
    sudo -u ringclip /opt/ringclip/venv/bin/python -m vision.coolbench run --label pip $CLIPS > /tmp/pip.json 2>> /var/log/ringclip/coolbench.log
    sudo -u ringclip env $COOL_ENV /opt/ringclip/venv/bin/python -m vision.coolbench run --label cool $CLIPS > /tmp/cool.json 2>> /var/log/ringclip/coolbench.log
    /opt/ringclip/venv/bin/python -m vision.coolbench compare /tmp/pip.json /tmp/cool.json >> /var/log/ringclip/coolbench.log
    cp /tmp/pip.json /tmp/cool.json /var/log/ringclip/
  } || echo "coolbench failed; the demo starts anyway" >> /var/log/ringclip/coolbench.log
  cd /opt/ringclip
else
  echo "COOL OpenCV did not import; the pipeline uses the pip wheel" | tee -a /var/log/ringclip/coolbench.log
fi
%{ endif ~}

# What the pipeline's own optimisations save on this machine: frames read and the detector run
# alongside the analysis (PIPELINE_PARALLEL) and the Arm FP16 detector (DETECTOR_FP16), timed on
# the published clips before the services compete for the CPU. Results go to CloudWatch.
cd /opt/ringclip/app
CLIPS=$(ls web/public/samples/*.mp4)
BENCH="sudo -u ringclip env $(cat /etc/ringclip/opencv.env | tr '\n' ' ')"
{
  $BENCH PIPELINE_PARALLEL=0 /opt/ringclip/venv/bin/python -m vision.coolbench run --label serial $CLIPS > /tmp/serial.json 2>> /var/log/ringclip/coolbench.log
  $BENCH /opt/ringclip/venv/bin/python -m vision.coolbench run --label parallel $CLIPS > /tmp/parallel.json 2>> /var/log/ringclip/coolbench.log
  $BENCH DETECTOR_FP16=1 /opt/ringclip/venv/bin/python -m vision.coolbench run --label parallel+fp16 $CLIPS > /tmp/fp16.json 2>> /var/log/ringclip/coolbench.log
  /opt/ringclip/venv/bin/python -m vision.coolbench compare /tmp/serial.json /tmp/parallel.json >> /var/log/ringclip/coolbench.log
  /opt/ringclip/venv/bin/python -m vision.coolbench compare /tmp/serial.json /tmp/fp16.json >> /var/log/ringclip/coolbench.log
  cp /tmp/serial.json /tmp/parallel.json /tmp/fp16.json /var/log/ringclip/
} || echo "pipeline benchmark failed; the demo starts anyway" >> /var/log/ringclip/coolbench.log
cd /opt/ringclip

cat > /etc/systemd/system/ringclip-decider.service <<'UNIT'
[Unit]
Description=Strands Decider 2B (CPU)
After=network-online.target
[Service]
User=ringclip
Environment=HF_HOME=/opt/ringclip/hf
Environment=HF_HUB_OFFLINE=1
ExecStart=/opt/ringclip/venv/bin/strands-decider serve ${decider_checkpoint} --device cpu --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:/var/log/ringclip/decider.log
StandardError=append:/var/log/ringclip/decider.log
[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/systemd/system/ringclip-playground.service <<'UNIT'
[Unit]
Description=LookTwice playground (public mode: capped uploads, removed hourly)
After=ringclip-decider.service
Wants=ringclip-decider.service
[Service]
User=ringclip
WorkingDirectory=/opt/ringclip/app
Environment=DECIDER_URL=http://127.0.0.1:8000
Environment=DECIDER_TIMEOUT=120
Environment=VISION_MODEL=${vision_model}
Environment=BEDROCK_REGION=${region}
Environment=AWS_DEFAULT_REGION=${region}
EnvironmentFile=/etc/ringclip/opencv.env
ExecStart=/opt/ringclip/venv/bin/python -m vision.playground --port 8091 --max-upload-mb 20 --uploads-per-hour 3 --upload-note "Uploads are removed every hour."
Restart=always
RestartSec=5
StandardOutput=append:/var/log/ringclip/playground.log
StandardError=append:/var/log/ringclip/playground.log
[Install]
WantedBy=multi-user.target
UNIT

# nginx in front: public port 80, uploads only on /api/upload (25 MB cap), live model calls rate-limited per visitor
cat > /etc/nginx/sites-available/ringclip <<'NGINX'
map $request_method $post_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $post_key zone=live:10m rate=12r/m;

server {
    listen 80 default_server;
    server_name _;
    client_max_body_size 64k;
    server_tokens off;

    if ($request_method !~ ^(GET|HEAD|POST|PUT)$) { return 405; }

    location = /api/upload {
        if ($request_method != PUT) { return 405; }
        client_max_body_size 25m;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host 127.0.0.1:8091;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 180s;
    }

    location / {
        if ($request_method = PUT) { return 405; }
        limit_req zone=live burst=6 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host 127.0.0.1:8091;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }
}
NGINX
ln -sf /etc/nginx/sites-available/ringclip /etc/nginx/sites-enabled/ringclip
rm -f /etc/nginx/sites-enabled/default

# Every hour: remove visitors' uploads and put the published analysis back, so every visitor sees the same demo
cat > /usr/local/bin/ringclip-hourly <<'PY'
#!/opt/ringclip/venv/bin/python
import pathlib, subprocess
BUCKET, REGION = "${bucket}", "${region}"
SAMPLES = pathlib.Path("/opt/ringclip/app/web/public/samples")
INBOX = pathlib.Path("/opt/ringclip/app/clips/inbox")
listing = subprocess.run(["/usr/local/bin/aws", "s3", "ls", "s3://" + BUCKET + "/samples/", "--region", REGION],
                         capture_output=True, text=True, check=True).stdout
keep = {line.split()[-1].split(".")[0] for line in listing.splitlines() if line.strip()}
for folder in (SAMPLES, INBOX):
    for f in folder.glob("*") if folder.exists() else []:
        if f.is_file() and f.name not in ("index.json", "inbox.json") and f.name.lstrip(".").split(".")[0] not in keep:
            f.unlink(missing_ok=True)
subprocess.run(["/usr/local/bin/aws", "s3", "cp", "s3://" + BUCKET + "/samples/", str(SAMPLES), "--recursive",
                "--exclude", "*", "--include", "*.timeline.json", "--region", REGION, "--only-show-errors"], check=True)
PY
chmod 755 /usr/local/bin/ringclip-hourly
echo "17 * * * * ringclip /usr/local/bin/ringclip-hourly >> /var/log/ringclip/hourly.log 2>&1" > /etc/cron.d/ringclip-hourly

systemctl daemon-reload
systemctl enable --now ringclip-decider.service ringclip-playground.service
nginx -t && systemctl restart nginx
echo "RINGCLIP BOOTSTRAP DONE"
